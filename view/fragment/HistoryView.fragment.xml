<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:layout="sap.ui.layout">

  <Dialog
    id="historyViewDialog"
    title="{i18n>HISTORY_VIEW_TITLE}"
    contentWidth="820px"
    contentHeight="720px"
    resizable="true"
    draggable="true"
    class="ebDialog ebHistoryViewDialog">

    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="{history>/subject}" class="ebHistorySubjectHeading" />

        <HBox alignItems="Center" wrap="Wrap" class="ebHistoryMetaRow">
          <Text text="{history>/localId}" class="ebHistoryMetaItem" />
          <Text text="·" class="ebHistoryMetaSep" />
          <Text text="{history>/createdAt}" class="ebHistoryMetaItem" />
        </HBox>

        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
          <Label text="{i18n>SEND_STATUS}" class="ebFieldLabel" />
          <Text
            text="{parts: [{path: 'i18n>TOTAL_COUNT'}, {path: 'history>/hud/total'}], formatter: '.formatter.formatCount'}"
            class="ebHudLabel" />
        </HBox>
        <HBox wrap="Wrap" class="ebStatusChipsRow" items="{history>/hud/statuses}">
          <ObjectStatus
            text="{parts: [{path: 'history>Status'}, {path: 'history>Count'}], formatter: '.formatter.statusChipText'}"
            state="{path: 'history>Status', formatter: '.formatter.statusState'}"
            icon="{path: 'history>Status', formatter: '.formatter.statusIcon'}"
            class="ebStatusChip" />
        </HBox>

        <Label text="{i18n>CONTENT}" class="ebFieldLabel sapUiSmallMarginTop" />
        <ScrollContainer height="400px" vertical="true" horizontal="false" class="ebHistoryScroll">
          <FormattedText
            htmlText="{path: 'history>/content', formatter: '.formatter.sanitizedHtml'}"
            class="ebHistoryContent" />
        </ScrollContainer>
      </VBox>
    </content>

    <buttons>
      <Button text="{i18n>COPY_TO_DRAFT}" press="onCopyViewingMailing" type="Emphasized" />
      <Button text="{i18n>CLOSE}" press="onCloseHistoryView" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>
