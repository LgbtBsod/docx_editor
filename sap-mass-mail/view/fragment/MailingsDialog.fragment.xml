<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="mailingsDialog"
    title="{i18n>DIALOG_MAILINGS}"
    contentWidth="720px"
    contentHeight="560px"
    resizable="true"
    draggable="true"
    class="ebDialog ebMailingsDialog">

    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="{i18n>MAILING_CLICK_HINT}" class="sapUiSmallMarginBottom" />
        <Table
          id="mailingsTable"
          items="{ path: '/MailHistorySet', parameters: { countMode: 'Inline' }, sorter: { path: 'CreatedAt', descending: true } }"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          class="ebDialogTable"
          noDataText="{i18n>NO_MAILINGS}">
          <columns>
            <Column width="25%" minScreenWidth="Phone" demandPopin="false">
              <Text text="{i18n>COL_LOCAL_ID}" />
            </Column>
            <Column width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>COL_SENDER}" />
            </Column>
            <Column width="20%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>COL_DATETIME}" />
            </Column>
            <Column width="40%" minScreenWidth="Phone" demandPopin="false">
              <Text text="{i18n>COL_SUBJECT}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Active">
              <cells>
                <Label text="{LocalID}" wrapping="true" design="Bold" />
                <Label text="{CreatedBy}" wrapping="true" />
                <Text text="{ path: 'CreatedAt', type: 'sap.ui.model.type.DateTime', formatOptions: { pattern: 'dd.MM.yyyy HH:mm' } }" />
                <Label text="{Subject}" wrapping="true" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>

    <buttons>
      <Button text="{i18n>CLOSE}" press="onCancelDialog" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>
