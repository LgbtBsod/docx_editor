<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:layout="sap.ui.layout"
  xmlns:search="emailbuilder.control">

  <Dialog
    id="recipientDialog"
    title="{i18n>DIALOG_RECIPIENTS}"
    contentWidth="720px"
    contentHeight="560px"
    resizable="true"
    draggable="true"
    class="ebDialog ebRecipientDialog">

    <content>
      <VBox class="sapUiSmallMargin">
        <IconTabBar
          id="recipientTabs"
          select="onRecipTabSelect"
          selectedKey="{dialog>/selectedMode}"
          class="ebIconTabBar"
          expandable="false">
          <items>
            <IconTabFilter icon="sap-icon://accept" text="{i18n>TAB_ADDED}" key="added"
              count="{= ${state>/recipients}.length || '' }" />
            <IconTabFilter icon="sap-icon://person" text="{i18n>TAB_BY_NAME}" key="name">
              <layout:Grid defaultSpan="L9 M9 S12" containerQuery="false" width="100%" class="sapUiSmallMarginBottom">
                <search:SearchField label="{i18n>COL_NAME}">
                  <search:layoutData>
                    <layout:GridData span="L9 M9 S12" />
                  </search:layoutData>
                  <Input
                    id="nameSearchInput"
                    placeholder="{i18n>SEARCH_NAME}"
                    value="{dialog>/nameSearchValue}"
                    submit="onSearchRecipients" />
                </search:SearchField>
                <search:SearchField>
                  <search:layoutData>
                    <layout:GridData span="L3 M3 S12" />
                  </search:layoutData>
                  <Button
                    icon="sap-icon://search"
                    press="onSearchRecipients"
                    type="Emphasized"
                    width="100%"
                    tooltip="{i18n>DIALOG_RECIPIENTS}" />
                </search:SearchField>
              </layout:Grid>
            </IconTabFilter>
            <IconTabFilter icon="sap-icon://role" text="{i18n>TAB_BY_ROLE}" key="role">
              <layout:Grid defaultSpan="L9 M9 S12" containerQuery="false" width="100%" class="sapUiSmallMarginBottom">
                <search:SearchField label="{i18n>COL_ROLE}">
                  <search:layoutData>
                    <layout:GridData span="L9 M9 S12" />
                  </search:layoutData>
                  <Input
                    id="roleSearchInput"
                    placeholder="{i18n>SEARCH_ROLE}"
                    value="{dialog>/roleSearchValue}"
                    submit="onSearchRecipients" />
                </search:SearchField>
                <search:SearchField>
                  <search:layoutData>
                    <layout:GridData span="L3 M3 S12" />
                  </search:layoutData>
                  <Button
                    icon="sap-icon://search"
                    press="onSearchRecipients"
                    type="Emphasized"
                    width="100%"
                    tooltip="{i18n>DIALOG_RECIPIENTS}" />
                </search:SearchField>
              </layout:Grid>
            </IconTabFilter>
            <IconTabFilter icon="sap-icon://key" text="{i18n>TAB_BY_AUTH}" key="authField">
              <layout:Grid defaultSpan="L3 M6 S12" containerQuery="false" width="100%" class="sapUiSmallMarginBottom">
                <search:SearchField label="{i18n>SEARCH_AUTH_OBJ}">
                  <search:layoutData>
                    <layout:GridData span="L3 M6 S12" />
                  </search:layoutData>
                  <Input
                    id="authObjInput"
                    placeholder="{i18n>SEARCH_AUTH_OBJ}"
                    value="{dialog>/authObject}"
                    submit="onSearchRecipients" />
                </search:SearchField>
                <search:SearchField label="{i18n>SEARCH_AUTH_FIELD}">
                  <search:layoutData>
                    <layout:GridData span="L3 M6 S12" />
                  </search:layoutData>
                  <Input
                    id="authFieldInput"
                    placeholder="{i18n>SEARCH_AUTH_FIELD}"
                    value="{dialog>/authField}"
                    submit="onSearchRecipients" />
                </search:SearchField>
                <search:SearchField label="{i18n>SEARCH_AUTH_VALUE}">
                  <search:layoutData>
                    <layout:GridData span="L3 M6 S12" />
                  </search:layoutData>
                  <Input
                    id="authValueInput"
                    placeholder="{i18n>SEARCH_AUTH_VALUE}"
                    value="{dialog>/authValue}"
                    submit="onSearchRecipients" />
                </search:SearchField>
                <search:SearchField>
                  <search:layoutData>
                    <layout:GridData span="L3 M12 S12" />
                  </search:layoutData>
                  <Button
                    icon="sap-icon://search"
                    press="onSearchRecipients"
                    type="Emphasized"
                    width="100%"
                    tooltip="{i18n>DIALOG_RECIPIENTS}" />
                </search:SearchField>
              </layout:Grid>
            </IconTabFilter>
          </items>
        </IconTabBar>

        <Table
          id="recipientTable"
          visible="{= ${dialog>/selectedMode} !== 'added' }"
          items="{ path: '/RecipientSet', parameters: { countMode: 'Inline' } }"
          mode="MultiSelect"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          class="ebDialogTable"
          noDataText="{i18n>NO_RECIPIENTS_FOUND}">
          <columns>
            <Column width="30%" minScreenWidth="Phone" demandPopin="false">
              <Text text="{i18n>COL_NAME}" />
            </Column>
            <Column width="20%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>COL_ROLE}" />
            </Column>
            <Column width="50%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Block">
              <Text text="{i18n>COL_EMAIL}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Active">
              <cells>
                <Text text="{FullName}" wrapping="true" />
                <Text text="{Role}" wrapping="true" />
                <Text text="{Email}" wrapping="true" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <!-- Already-added recipients: view + remove. Bound to the app "state"
             model (not the OData model) since it reflects local compose state. -->
        <List
          id="addedRecipientsList"
          visible="{= ${dialog>/selectedMode} === 'added' }"
          items="{state>/recipients}"
          growing="true"
          growingThreshold="50"
          growingScrollToLoad="true"
          noDataText="{i18n>NO_RECIPIENTS}"
          class="ebDialogTable"
          inset="false">
          <items>
            <CustomListItem class="ebSourceItem">
              <HBox alignItems="Center" width="100%" class="ebSourceItemRow">
                <core:Icon src="sap-icon://person-placeholder" size="1.2rem" class="ebSourceIcon" />
                <VBox class="ebSourceInfo">
                  <Text text="{state>name}" class="ebSourceName" wrapping="true" />
                  <Text text="{state>email}" class="ebSourceMeta" />
                </VBox>
                <Button icon="sap-icon://decline" type="Transparent" press="onRemoveAddedRecipient" tooltip="{i18n>TIP_REMOVE_SOURCE}" />
              </HBox>
            </CustomListItem>
          </items>
        </List>
      </VBox>
    </content>

    <buttons>
      <Button text="{i18n>ADD_SELECTED}" press="onAddSelectedRecipients" type="Emphasized"
        visible="{= ${dialog>/selectedMode} !== 'added' }" />
      <Button text="{i18n>CLEAR_ALL_RECIPIENTS}" press="onClearAllRecipients" type="Transparent"
        visible="{= ${dialog>/selectedMode} === 'added' }" />
      <Button text="{i18n>CANCEL}" press="onCancelDialog" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>
