<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:layout="sap.ui.layout"
  xmlns:search="emailbuilder.control">

  <Dialog
    id="newsDialog"
    title="{i18n>DIALOG_NEWS}"
    contentWidth="680px"
    contentHeight="560px"
    resizable="true"
    draggable="true"
    class="ebDialog ebNewsDialog">

    <content>
      <VBox class="sapUiSmallMargin">
        <IconTabBar
          id="newsTabs"
          select="onNewsTabSelect"
          selectedKey="{dialog>/selectedMode}"
          class="ebIconTabBar"
          expandable="false">
          <items>
            <IconTabFilter icon="sap-icon://accept" text="{i18n>TAB_ADDED}" key="added"
              count="{= ${state>/newsItems}.length || '' }" />
            <IconTabFilter icon="sap-icon://search" text="{i18n>DIALOG_NEWS}" key="search">
              <layout:Grid
                defaultSpan="L3 M6 S12"
                containerQuery="false"
                width="100%"
                class="sapUiSmallMarginBottom">
                <search:SearchField label="{i18n>YEAR}">
                  <search:layoutData>
                    <layout:GridData span="L3 M6 S12" />
                  </search:layoutData>
                  <Input
                    placeholder="{i18n>YEAR_PLACEHOLDER}"
                    value="{dialog>/year}"
                    submit="onSearchNews" />
                </search:SearchField>
                <search:SearchField label="{i18n>QUARTER}">
                  <search:layoutData>
                    <layout:GridData span="L3 M6 S12" />
                  </search:layoutData>
                  <Select selectedKey="{dialog>/quarter}" change="onSearchNews">
                    <items>
                      <core:Item key="all" text="{i18n>ALL}" />
                      <core:Item key="1" text="Q1" />
                      <core:Item key="2" text="Q2" />
                      <core:Item key="3" text="Q3" />
                      <core:Item key="4" text="Q4" />
                    </items>
                  </Select>
                </search:SearchField>
                <search:SearchField label="{i18n>AREA}">
                  <search:layoutData>
                    <layout:GridData span="L3 M6 S12" />
                  </search:layoutData>
                  <Select selectedKey="{dialog>/area}" change="onSearchNews">
                    <items>
                      <core:Item key="" text="{i18n>ALL}" />
                      <core:Item key="Маркетинг" text="{i18n>AREA_MARKETING}" />
                      <core:Item key="Юридический" text="{i18n>AREA_LEGAL}" />
                      <core:Item key="Производство" text="{i18n>AREA_PRODUCTION}" />
                      <core:Item key="Финансы" text="{i18n>AREA_FINANCE}" />
                      <core:Item key="HR" text="{i18n>AREA_HR}" />
                      <core:Item key="IT" text="{i18n>AREA_IT}" />
                      <core:Item key="Логистика" text="{i18n>AREA_LOGISTICS}" />
                      <core:Item key="Безопасность" text="{i18n>AREA_SECURITY}" />
                    </items>
                  </Select>
                </search:SearchField>
                <search:SearchField>
                  <search:layoutData>
                    <layout:GridData span="L3 M12 S12" />
                  </search:layoutData>
                  <Button
                    icon="sap-icon://search"
                    press="onSearchNews"
                    type="Emphasized"
                    width="100%"
                    tooltip="{i18n>DIALOG_NEWS}" />
                </search:SearchField>
              </layout:Grid>
            </IconTabFilter>
          </items>
        </IconTabBar>

        <Table
          id="newsTable"
          visible="{= ${dialog>/selectedMode} !== 'added' }"
          items="{ path: '/NewsSet', parameters: { countMode: 'Inline' } }"
          mode="MultiSelect"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          class="ebDialogTable"
          noDataText="{i18n>NO_NEWS_RESULTS}">
          <columns>
            <Column width="55%" minScreenWidth="Phone" demandPopin="false">
              <Text text="{i18n>NEWS_TITLE}" />
            </Column>
            <Column width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>YEAR}" />
            </Column>
            <Column width="30%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
              <Text text="{i18n>AREA}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Active">
              <cells>
                <Text text="{Title}" wrapping="true" />
                <Text text="{Year}" />
                <Text text="{Area}" wrapping="true" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <!-- Already-added news: view + remove. Bound to the app "state" model
             (not the OData model) since it reflects local compose state. -->
        <List
          id="addedNewsList"
          visible="{= ${dialog>/selectedMode} === 'added' }"
          items="{state>/newsItems}"
          growing="true"
          growingThreshold="50"
          growingScrollToLoad="true"
          noDataText="{i18n>NO_NEWS}"
          class="ebDialogTable"
          inset="false">
          <items>
            <CustomListItem class="ebSourceItem">
              <HBox alignItems="Center" width="100%" class="ebSourceItemRow">
                <core:Icon src="sap-icon://notification" size="1.2rem" class="ebSourceIcon" />
                <VBox class="ebSourceInfo">
                  <Text text="{state>title}" class="ebSourceName" wrapping="true" />
                  <Text text="{state>meta}" class="ebSourceMeta" />
                </VBox>
                <Button icon="sap-icon://decline" type="Transparent" press="onRemoveNewsItem" tooltip="{i18n>TIP_REMOVE_SOURCE}" />
              </HBox>
            </CustomListItem>
          </items>
        </List>
      </VBox>
    </content>

    <buttons>
      <Button text="{i18n>ADD_AS_SOURCES}" press="onAddSelectedNews" type="Emphasized"
        visible="{= ${dialog>/selectedMode} !== 'added' }" />
      <Button text="{i18n>CLEAR_ALL_NEWS}" press="onClearAllNews" type="Transparent"
        visible="{= ${dialog>/selectedMode} === 'added' }" />
      <Button text="{i18n>CANCEL}" press="onCancelDialog" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>
