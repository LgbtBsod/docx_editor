<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:comp="sap.ui.comp.smartfilterbar"
  xmlns:core="sap.ui.core">

  <Dialog
    id="newsDialog"
    title="{i18n>DIALOG_NEWS}"
    contentWidth="680px"
    contentHeight="560px"
    resizable="true"
    draggable="true"
    class="ebDialog ebNewsDialog">

    <content>
      <VBox class="sapUiSmallMargin">
        <IconTabBar
          id="newsTabs"
          select="onNewsTabSelect"
          selectedKey="{dialog>/selectedMode}"
          class="ebIconTabBar"
          expandable="false">
          <items>
            <IconTabFilter icon="sap-icon://accept" text="{i18n>TAB_ADDED}" key="added"
              count="{= ${state>/newsItems}.length || '' }" />

            <IconTabFilter icon="sap-icon://search" text="{i18n>TAB_SEARCH}" key="search">
              <VBox>
                <comp:SmartFilterBar
                  id="newsSFB"
                  entitySet="NewsSet"
                  liveMode="false"
                  showGoOnFB="true"
                  showClearOnFB="true"
                  useToolbar="false"
                  search="onSmartFilterSearch"
                  clear="onSmartFilterSearch">
                  <comp:controlConfiguration>
                    <comp:ControlConfiguration
                      key="NewID"
                      visibleInAdvancedArea="false" />
                    <comp:ControlConfiguration
                      key="NewsType"
                      index="0"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="Title"
                      index="1"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="Year"
                      index="2"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="Quarter"
                      index="3"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="Area"
                      index="4"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="ChangeNumber"
                      index="5"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="InitiatorName"
                      index="6"
                      visibleInAdvancedArea="true" />
                    <comp:ControlConfiguration
                      key="NewsTypeText"
                      visibleInAdvancedArea="false" />
                    <comp:ControlConfiguration
                      key="Content"
                      visibleInAdvancedArea="false" />
                  </comp:controlConfiguration>
                </comp:SmartFilterBar>
                <!-- "Только изменения" toggle removed — the SFB NewsType
                     dropdown above (index 0) covers the same filter via
                     Filter("NewsType", EQ, "CHG"). One SSOT, one control. -->
              </VBox>
            </IconTabFilter>
          </items>
        </IconTabBar>

        <Table
          id="newsTable"
          visible="{= ${dialog>/selectedMode} !== 'added' }"
          items="{ path: '/NewsSet', parameters: { countMode: 'Inline' } }"
          mode="MultiSelect"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          class="ebDialogTable"
          noDataText="{i18n>NO_NEWS_RESULTS}">
          <columns>
            <Column width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>NEWS_TYPE_LABEL}" />
            </Column>
            <Column width="12%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>NEWS_CHANGE_NUMBER}" />
            </Column>
            <Column width="38%" minScreenWidth="Phone" demandPopin="false">
              <Text text="{i18n>NEWS_TITLE}" />
            </Column>
            <Column width="12%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>YEAR}" />
            </Column>
            <Column width="23%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
              <Text text="{i18n>AREA}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Active">
              <cells>
                <Text text="{NewsTypeText}" wrapping="true" />
                <Text text="{ChangeNumber}" />
                <Text text="{Title}" wrapping="true" />
                <Text text="{Year}" />
                <Text text="{Area}" wrapping="true" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <!-- Already-added news: view + remove. Bound to the app "state" model
             (not the OData model) since it reflects local compose state. -->
        <List
          id="addedNewsList"
          visible="{= ${dialog>/selectedMode} === 'added' }"
          items="{state>/newsItems}"
          growing="true"
          growingThreshold="50"
          growingScrollToLoad="true"
          noDataText="{i18n>NO_NEWS}"
          class="ebDialogTable"
          inset="false">
          <items>
            <CustomListItem class="ebSourceItem">
              <HBox alignItems="Center" width="100%" class="ebSourceItemRow">
                <core:Icon src="sap-icon://notification" size="1.2rem" class="ebSourceIcon" />
                <VBox class="ebSourceInfo">
                  <Text text="{state>title}" class="ebSourceName" wrapping="true" />
                  <Text text="{state>meta}" class="ebSourceMeta" />
                </VBox>
                <Button icon="sap-icon://decline" type="Transparent" press="onRemoveNewsItem" tooltip="{i18n>TIP_REMOVE_SOURCE}" />
              </HBox>
            </CustomListItem>
          </items>
        </List>
      </VBox>
    </content>

    <buttons>
      <Button text="{i18n>ADD_AS_SOURCES}" press="onAddSelectedNews" type="Emphasized"
        visible="{= ${dialog>/selectedMode} !== 'added' }" />
      <Button text="{i18n>CLEAR_ALL_NEWS}" press="onClearAllNews" type="Transparent"
        visible="{= ${dialog>/selectedMode} === 'added' }" />
      <Button text="{i18n>CANCEL}" press="onCancelDialog" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>