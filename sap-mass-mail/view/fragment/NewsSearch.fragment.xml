<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:layout="sap.ui.layout">

  <Dialog
    id="newsDialog"
    title="{i18n>DIALOG_NEWS}"
    contentWidth="640px"
    contentHeight="560px"
    resizable="true"
    draggable="true"
    class="ebDialog ebNewsDialog">

    <content>
      <VBox class="sapUiSmallMargin">
        <layout:Grid
          defaultSpan="L3 M6 S12"
          containerQuery="false"
          width="100%"
          class="sapUiSmallMarginBottom">
          <VBox class="ebSearchInput">
            <Label text="{i18n>YEAR}" class="ebFieldLabel" />
            <Input
              placeholder="{i18n>YEAR_PLACEHOLDER}"
              value="{dialog>/year}"
              submit="onSearchNews">
              <layoutData>
                <layout:GridData span="L3 M6 S12" />
              </layoutData>
            </Input>
          </VBox>
          <VBox class="ebSearchInput">
            <Label text="{i18n>QUARTER}" class="ebFieldLabel" />
            <Select selectedKey="{dialog>/quarter}" change="onSearchNews">
              <items>
                <core:Item key="all" text="{i18n>ALL}" />
                <core:Item key="1" text="Q1" />
                <core:Item key="2" text="Q2" />
                <core:Item key="3" text="Q3" />
                <core:Item key="4" text="Q4" />
              </items>
              <layoutData>
                <layout:GridData span="L3 M6 S12" />
              </layoutData>
            </Select>
          </VBox>
          <VBox class="ebSearchInput">
            <Label text="{i18n>AREA}" class="ebFieldLabel" />
            <Select selectedKey="{dialog>/area}" change="onSearchNews">
              <items>
                <core:Item key="" text="{i18n>ALL}" />
                <core:Item key="Technical" text="Technical" />
                <core:Item key="Business" text="Business" />
                <core:Item key="Strategic" text="Strategic" />
                <core:Item key="Operations" text="Operations" />
              </items>
              <layoutData>
                <layout:GridData span="L3 M6 S12" />
              </layoutData>
            </Select>
          </VBox>
          <Button
            icon="sap-icon://search"
            press="onSearchNews"
            type="Emphasized"
            tooltip="{i18n>DIALOG_NEWS}">
            <layoutData>
              <layout:GridData span="L3 M12 S12" />
            </layoutData>
          </Button>
        </layout:Grid>

        <Table
          id="newsTable"
          items="{ path: '/NewsSet', parameters: { countMode: 'Inline' } }"
          mode="MultiSelect"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          class="ebDialogTable"
          noDataText="{i18n>NO_NEWS_RESULTS}">
          <columns>
            <Column width="65%" minScreenWidth="Phone" demandPopin="false">
              <Text text="{i18n>NEWS_TITLE}" />
            </Column>
            <Column width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
              <Text text="{i18n>YEAR}" />
            </Column>
            <Column width="20%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
              <Text text="{i18n>AREA}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Active">
              <cells>
                <Text text="{Title}" wrapping="true" />
                <Text text="{Year}" />
                <Text text="{Area}" wrapping="true" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>

    <buttons>
      <Button text="{i18n>ADD_AS_SOURCES}" press="onAddSelectedNews" type="Emphasized" />
      <Button text="{i18n>CANCEL}" press="onCancelDialog" />
    </buttons>

  </Dialog>
</core:FragmentDefinition>
