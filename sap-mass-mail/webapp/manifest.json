{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.sap.mm.massmail",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZMM_MASSMAIL_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "offline": false,
    "sourceTemplate": {
      "id": "ui5template.fioriElementsApp",
      "version": "1.71.0"
    },
    "crossNavigation": {
      "inbounds": {
        "massmail-display": {
          "semanticObject": "MassMail",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://email",
      "favIcon": "sap-icon://email",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": false,
      "phone": false
    },
    "supportedThemes": [
      "sap_fiori_3",
      "sap_fiori_3_dark",
      "sap_belize",
      "sap_bluecrystal"
    ]
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.71.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sap.mm.massmail.i18n.i18n",
          "supportedLocales": [
            "en",
            "ru",
            "de"
          ],
          "fallbackLocale": "en"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false,
          "metadataUrlParams": {
            "sap-value-list": "none"
          }
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ],
      "js": [
        {
          "uri": "libs/mammoth.browser.min.js"
        }
      ]
    },
    "rootView": {
      "viewName": "com.sap.mm.massmail.view.Main",
      "type": "XML",
      "async": true,
      "id": "Main"
    },
    "extends": {
      "extensions": {
        "sap.ui.viewExtensions": {
          "com.sap.mm.massmail.view.Main": {
            "beforePageHeader|CustomActions": {
              "className": "sap.ui.core.Fragment",
              "fragmentName": "com.sap.mm.massmail.fragment.CustomActions",
              "type": "XML"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "comsapmmmassmail"
  },
  "sap.platform.abap": {
    "uri": ""
  },
  "sap.platform.hcp": {
    "uri": ""
  }
}
